# ─────────────────────────────────────────────────────────────────────────────
# Healthcare AI Assistant — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────
# Get a free key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── LLM Settings (optional — defaults shown) ─────────────────────────────────
GROQ_MODEL=llama-3.1-8b-instant

# Comma-separated fallback models tried in order if the primary fails.
# Edit this without code changes if Groq deprecates a model.
# Note: llama-3.1-8b-instant and llama-3.3-70b-versatile are deprecated
# as of June 2026; openai/gpt-oss-20b and openai/gpt-oss-120b are
# Groq's recommended replacements. Keep the list up to date here.
GROQ_FALLBACK_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-20b,openai/gpt-oss-120b

# ── Embedding Settings (optional — defaults shown) ────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── ChromaDB Settings (optional — defaults shown) ─────────────────────────────
CHROMA_PERSIST_DIR=./vector_store
CHROMA_COLLECTION_NAME=healthcare_docs

# ── Document Ingestion Settings (optional — defaults shown) ───────────────────
DATA_DIR=./data
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_K=3

# ── Retrieval Threshold (optional — defaults shown) ───────────────────────────
# Minimum cosine similarity score (0.0-1.0) for a chunk to be used in context.
# Raise to reduce hallucination risk; lower to get answers on more questions.
SIMILARITY_SCORE_THRESHOLD=0.35

# ── CORS Settings (optional — defaults shown) ─────────────────────────────────
# Comma-separated list of allowed frontend origins.
# For local dev, point at your Streamlit port.
# For production, set this to your deployed frontend's exact URL(s).
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
ALLOWED_METHODS=GET,POST
ALLOWED_HEADERS=Content-Type
# Must be false when ALLOWED_ORIGINS does not contain only specific origins,
# and always false for this app since no cookies/auth headers are used.
CORS_ALLOW_CREDENTIALS=false

# ── Question Length Validation (optional — defaults shown) ────────────────────
QUESTION_MIN_LENGTH=3
QUESTION_MAX_LENGTH=500

# ── Server Settings (optional — defaults shown) ───────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ── Logging Format (optional — defaults shown) ────────────────────────────────
# "text" for human-readable plain-text logs (default, good for development).
# "json" for structured JSON log lines (use on production observability
#  platforms like Datadog, ELK, Splunk where each line must be parseable JSON).
LOG_FORMAT=text

# ── Frontend (set this in Streamlit Cloud Secrets for hosted deployment) ───────
# API_BASE_URL=https://your-backend-url.hf.space
